<configuration>
  <!-- Development profile: Console logging -->
  <springProfile name="dev">
    <appender class="ch.qos.logback.core.ConsoleAppender" name="CONSOLE">
      <encoder>
        <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg %X%n</pattern>
      </encoder>
    </appender>
    <root level="DEBUG">
      <appender-ref ref="CONSOLE"/>
    </root>
  </springProfile>

  <!-- Production profile: JSON file logging with rotation and async -->
  <springProfile name="prod">
    <appender class="ch.qos.logback.core.rolling.RollingFileAppender" name="FILE">
      <encoder class="net.logstash.logback.encoder.LogstashEncoder"/>
      <file>logs/marketmind.log</file>
      <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
        <fileNamePattern>logs/marketmind.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
        <maxFileSize>10MB</maxFileSize>
        <maxHistory>5</maxHistory>
        <totalSizeCap>1GB</totalSizeCap>
      </rollingPolicy>
    </appender>

    <appender class="ch.qos.logback.classic.AsyncAppender" name="ASYNC">
      <appender-ref ref="FILE"/>
    </appender>

    <root level="INFO">
      <appender-ref ref="ASYNC"/>
      <appender-ref ref="FILE"/>
    </root>
  </springProfile>
</configuration>