{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketmind.ai/schemas/gate_decision.schema.json",
  "title": "Gate Decision",
  "description": "Gate decision artifact (always emitted by gate runner).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "v1",
      "description": "Schema version"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of the decision (not part of gate_decision_hash)"
    },
    "result": {
      "type": "string",
      "enum": ["PASS", "FAIL"],
      "description": "Gate decision result"
    },
    "gate_policy_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "Hash of canonicalized policy + schema manifests"
    },
    "gate_decision_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "Deterministic hash of decision inputs (excludes timestamp)"
    },
    "reasons": {
      "type": "array",
      "description": "List of errors/violations that caused FAIL (empty on PASS)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "description": "Machine-readable error code"
          },
          "severity": {
            "type": "string",
            "enum": ["ERROR", "WARNING"],
            "description": "Error severity (always ERROR in v1)"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "description": "Human-readable description"
          },
          "file": {
            "type": "string",
            "description": "File path that caused error"
          },
          "uri": {
            "type": "string",
            "description": "URI that caused error"
          },
          "path": {
            "type": "string",
            "description": "JSON pointer path"
          },
          "schema_path": {
            "type": "string",
            "description": "Schema JSON pointer"
          },
          "context": {
            "type": "object",
            "additionalProperties": true,
            "description": "Additional context (expected vs actual, etc.)"
          }
        },
        "required": ["code", "severity", "message"]
      }
    },
    "artifact_refs": {
      "type": "array",
      "description": "References to evaluated artifacts",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artifact_type": {
            "type": "string",
            "minLength": 1,
            "description": "Type of artifact"
          },
          "uri": {
            "type": "string",
            "minLength": 1,
            "description": "URI of the artifact"
          },
          "content_hash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$",
            "description": "Content hash of the artifact"
          }
        },
        "required": ["artifact_type", "uri", "content_hash"]
      }
    }
  },
  "required": ["schema_version", "timestamp", "result", "gate_policy_hash", "gate_decision_hash", "reasons", "artifact_refs"]
}
