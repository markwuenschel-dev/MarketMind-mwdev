{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketmind.local/schemas/phase2_task_manifest.schema.json",
  "title": "MarketMind Phase II Task Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_version",
    "run_id",
    "timestamp",
    "non_promotable",
    "phase",
    "promotable_claim_emitted",
    "governed_artifact_contract",
    "run_identity",
    "seed_lineage",
    "content_hash",
    "tasks"
  ],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^rg09\\.task_manifest\\.scaffold\\." },
    "artifact_version": { "type": "string", "const": "mln06.phase2.contract.v1" },
    "run_id": { "type": "string", "pattern": "^run\\.sha256:[0-9a-f]{64}$" },
    "timestamp": { "type": "string", "minLength": 1 },
    "non_promotable": { "type": "boolean", "const": true },
    "phase": { "type": "string", "const": "II-0B" },
    "promotable_claim_emitted": { "type": "boolean", "const": false },
    "governed_artifact_contract": { "type": "boolean", "const": true },
    "run_identity": { "$ref": "#/$defs/run_identity" },
    "seed_lineage": { "$ref": "#/$defs/seed_lineage" },
    "content_hash": { "$ref": "#/$defs/content_hash" },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/task_row" }
    }
  },
  "$defs": {
    "content_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "value"],
      "properties": {
        "algorithm": { "type": "string", "const": "sha256" },
        "canonicalization": {
          "type": "string",
          "const": "json.sort_keys.no_ws.omit_content_hash.v1"
        },
        "value": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "run_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "seed", "run_id", "non_promotable"],
      "properties": {
        "schema_version": { "type": "string", "const": "phase2_scaffold.run_identity.v1" },
        "seed": { "type": "integer", "minimum": 0 },
        "run_id": { "type": "string", "pattern": "^run\\.sha256:[0-9a-f]{64}$" },
        "non_promotable": { "type": "boolean", "const": true }
      }
    },
    "seed_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "run_seed_root", "derived_seeds"],
      "properties": {
        "schema_version": { "type": "string", "const": "phase2.seed_lineage.v1" },
        "run_seed_root": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "derived_seeds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/derived_seed" }
        }
      }
    },
    "derived_seed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "context_string_sha256", "derived_seed_hex", "uint64_seed"],
      "properties": {
        "namespace": {
          "type": "string",
          "enum": [
            "task_sampling",
            "task_window_selection",
            "replay_curriculum_sampling",
            "checkpoint_reference_eval"
          ]
        },
        "context_string_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "derived_seed_hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "uint64_seed": { "type": "integer", "minimum": 0, "maximum": 18446744073709551615 }
      }
    },
    "task_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "regime_id",
        "regime_class",
        "t0",
        "t1",
        "pit_boundary",
        "signal_ids_hash",
        "signal_set_version",
        "provisional"
      ],
      "properties": {
        "task_id": { "type": "string", "minLength": 1 },
        "regime_id": { "type": "string", "minLength": 1 },
        "regime_class": { "type": "string", "minLength": 1 },
        "t0": { "type": "string", "minLength": 1 },
        "t1": { "type": "string", "minLength": 1 },
        "pit_boundary": { "type": "string", "minLength": 1 },
        "signal_ids_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "signal_set_version": { "type": "string", "minLength": 1 },
        "provisional": { "type": "boolean", "const": true }
      }
    }
  }
}
